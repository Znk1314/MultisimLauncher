# build output - never commit these
/bin/
/obj/
/dist/
*.pdb
*.user
*.suo

# NOTE: release/ is deliberately NOT ignored. See the bottom of this file.

# installer build leftovers
installer/*.log
installer/*.tmp

# IDE / editor
.vs/
.vscode/
.idea/
*.swp

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# local run logs, in case anyone runs a tool from inside the checkout
*.log
logs/

# ---------------------------------------------------------------------------
# The two binaries below ARE meant to be committed, so that anyone landing on
# the repository can download a ready-to-run build without a Releases page.
# They live in release/ precisely so that build output and shipped artifacts
# never get confused with each other.
# ---------------------------------------------------------------------------
!/release/MultisimLauncher.exe
!/release/MultisimLauncher-Setup.exe
